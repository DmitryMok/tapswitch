{
  "manifest_version": 3,
  "name": "Tapswitch — вкладки",
  "version": "1.2",
  "description": "Передаёт приложению Tapswitch список вкладок и переключает вкладку по нажатию кнопки панели.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tapswitch — вкладки",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  }
}
